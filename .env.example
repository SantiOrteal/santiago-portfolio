# Public origin used for canonical, hreflang, and JSON-LD URLs.
VITE_SITE_URL=https://santiorteal.com

# ── Contact form (docs/CONTACT_FORM_HANDOFF.md) ──────────────────────────
# Configure one or both. With both, messages go to both in parallel and the
# form succeeds if at least one accepts it. With none, the form opens the
# visitor's email app with the message prefilled.

# Web3Forms access key (https://web3forms.com). Public by design.
VITE_WEB3FORMS_KEY=

# n8n production webhook URL exposed through the Cloudflare Tunnel.
VITE_N8N_WEBHOOK_URL=

# Optional shared value the n8n workflow checks in the X-Portfolio-Token
# header. It ships in the JS bundle, so it filters casual abuse only.
VITE_N8N_WEBHOOK_TOKEN=
